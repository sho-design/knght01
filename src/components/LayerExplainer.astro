---
// Ten seconds per layer: one idea, drawn in line, played when it comes into view (site.js).
// Classes: x-in (rise in), x-out (leave), x-draw (stroke draws on), x-pop (seal or node lands), x-type (typed), x-go (gathers to a point).
// --d is when it arrives, --o when it leaves. Without motion or script, the last frame shows.
// Everything here is an illustration of the craft, not a client.
interface Props { id: string; name: string }
const { id, name } = Astro.props;
const d = (s: number, o?: number, extra = '') => `--d:${s}s;${o !== undefined ? `--o:${o}s;` : ''}${extra}`;
const BEATS: Record<string, string[]> = {
  lore: ['It starts with what you already know, in pieces.', 'We turn it into one line the whole team can repeat.', 'Then a name and a mark to carry it.'],
  law: ['Here is a claim a regulator would flag.', 'We cross it out and note the rule it breaks.', 'Then rewrite it to say only what you can back up.'],
  language: ['First we write the voice down.', 'Then we use it on every channel.', 'A post, an email and a sign end up sounding like the same business.'],
  map: ['Someone nearby searches.', 'Your listing shows up and stands out.', 'Booking takes one tap.'],
  ground: ['We plan the space as a route.', 'Signs show people where to go, so staff don’t have to.', 'Nobody has to wonder where to go next.'],
  artifacts: ['The box starts as a flat dieline, drawn to size.', 'Every line and the barcode get checked against the labelling rules.', 'Then it gets folded, filled and sold.'],
  machinery: ['This is what happens after someone gets in touch.', 'They get booked and reminded automatically.', 'Afterwards they’re asked for a review, and it starts again.'],
};
const AT = [0.2, 3.0, 6.0];
const beats = BEATS[id] || [];
const words = [
  ['what we believe', 150, 90], ['who we serve', 590, 70], ['how we sound', 360, 48], ['who we stand against', 630, 190],
  ['why now', 120, 250], ['what we promise', 560, 330], ['what we never say', 230, 350],
] as const;
---
{beats.length > 0 && (
<section class="wsec lx-sec" aria-label={`${name}, in ten seconds`}>
  <div class="wrap">
    <div class="lx__head"><p class="eyebrow">{name}, in ten seconds</p><span class="lx__tag">Illustration, not a client</span></div>
    <div class={`lx lx--${id}`} data-lx>
      <svg viewBox="0 0 800 420" class="lx__svg" role="img" aria-label={beats.join(' ')}>
        {id === 'lore' && (<>
          {words.map(([w, x, y], k) => <text x={x} y={y} class="lx-s x-in x-go" style={d(0.3 + k * 0.22, 2.6 + k * 0.08, `--tx:${400 - x}px;--ty:${205 - y}px`)}>{w}</text>)}
          <circle cx="400" cy="205" r="5" class="lx-dot x-pop x-out" style={d(3.0, 3.6)} />
          <text x="400" y="216" class="lx-h lx-h--l x-in x-out" style={d(3.6, 6.0)}>Worlds built inside the rules.</text>
                    <g transform="translate(250 206.06) scale(0.5000)"><circle cx="30" cy="60" r="16" pathLength="1" class="lx-line x-draw" style={d(6.4, undefined, '--t:.5s;stroke-width:5')} /><path d="M46 60 H120 M120 30 V90 M136 51 L530 51 L594 60 L530 69 L136 69 Z" pathLength="1" class="lx-line x-draw" style={d(6.7, undefined, '--t:1.2s;stroke-width:5')} /></g>
          <text x="250" y="200" textLength="300" lengthAdjust="spacing" class="lx-logo x-in" style={d(7.2, undefined, 'font-size:65.2px')}>KNGHT</text>
          <text x="400" y="300" class="lx-h lx-h--s x-in" style={d(7.8)}>Worlds built inside the rules.</text>
        </>)}
        {id === 'law' && (<>
          <rect x="140" y="62" width="520" height="270" rx="6" pathLength="1" class="lx-line x-draw" style={d(0.2)} />
          <text x="172" y="100" class="lx-s lx-s--l lx-start x-in" style={d(0.6)}>Ad, before</text>
          <text x="172" y="160" class="lx-h lx-h--l lx-start x-in x-dim" style={d(0.9, 3.4)}>Painless. Guaranteed results.</text>
          <path d="M166 152 L596 146" pathLength="1" class="lx-strike x-draw" style={d(3.0, undefined, '--t:.5s')} />
          <text x="172" y="196" class="lx-s lx-note lx-start x-in" style={d(3.6)}>The rule: no guarantee of outcome, no promise of no pain.</text>
          <text x="172" y="250" class="lx-h lx-h--l lx-start x-in" style={d(6.0)}>Gentle by design.</text>
          <text x="172" y="292" class="lx-h lx-h--l lx-start x-in" style={d(6.4)}>Results vary by person.</text>
          <g class="x-pop" style={d(7.4)}><circle cx="590" cy="270" r="30" class="lx-line" /><circle cx="590" cy="270" r="23" class="lx-line lx-faint" /></g>
          <path d="M577 270 L587 280 L604 260" pathLength="1" class="lx-line lx-bold x-draw" style={d(7.8, undefined, '--t:.4s')} />
        </>)}
        {id === 'language' && (<>
          <text x="400" y="34" class="lx-s x-in" style={d(0.1)}>The voice</text>
          <text x="400" y="82" class="lx-h lx-h--l x-in" style={d(0.4)}>Plain. Warm. Certain.</text>
          {[150, 400, 650].map((x, k) => <path d={`M400 104 C400 150 ${x} 140 ${x} 190`} pathLength="1" class="lx-line lx-faint x-draw" style={d(3.0 + k * 0.2)} />)}
          {[60, 310, 560].map((x, k) => <rect x={x} y="190" width="180" height="150" rx="6" pathLength="1" class="lx-line x-draw" style={d(3.4 + k * 0.2)} />)}
          {(['A post', 'An email', 'A sign'] as const).map((t, k) => <text x={150 + k * 250} y="220" class="lx-s x-in" style={d(3.8 + k * 0.2)}>{t}</text>)}
          {([['Open late Thursdays.', 'Come as you are.'], ['Your visit is set.', 'Here is what to bring.'], ['Please take a seat.', 'We will come to you.']] as const).map(([a, b], k) => (<>
            <text x={150 + k * 250} y="268" class="lx-h lx-h--s x-in" style={d(6.0 + k * 0.4)}>{a}</text>
            <text x={150 + k * 250} y="296" class="lx-h lx-h--s x-in" style={d(6.2 + k * 0.4)}>{b}</text>
          </>))}
        </>)}
        {id === 'map' && (<>
          <rect x="160" y="30" width="480" height="50" rx="25" pathLength="1" class="lx-line x-draw" style={d(0.2)} />
          <circle cx="192" cy="53" r="9" class="lx-line x-in" style={d(0.5)} /><path d="M199 60 L207 68" class="lx-line x-in" style={d(0.5)} />
          <text x="222" y="62" class="lx-s lx-s--l lx-start x-type" style={d(0.8, undefined, '--t:1.4s')}>dentist near me</text>
          <g class="x-in x-out" style={d(2.2, 5.6)}>
            <rect x="160" y="108" width="480" height="40" rx="4" class="lx-line lx-faint" /><path d="M180 128 H420" class="lx-line lx-faint" />
            <rect x="160" y="208" width="480" height="40" rx="4" class="lx-line lx-faint" /><path d="M180 228 H380" class="lx-line lx-faint" />
          </g>
          <g class="x-in x-out" style={d(2.6, 5.6)}>
            <rect x="160" y="158" width="480" height="40" rx="4" class="lx-line" />
            <text x="180" y="184" class="lx-h lx-h--s lx-start">Your clinic</text><text x="620" y="184" class="lx-s lx-end">Open now · Book online</text>
          </g>
          <rect x="156" y="154" width="488" height="48" rx="6" pathLength="1" class="lx-line lx-bold x-draw x-out" style={d(3.4, 5.6, '--t:.6s')} />
          <rect x="200" y="100" width="400" height="290" rx="6" pathLength="1" class="lx-line x-draw" style={d(6.0)} />
          <path d="M200 128 H600 M224 160 H470 M224 182 H420" class="lx-line lx-faint x-in" style={d(6.3)} />
          <g class="x-pop" style={d(6.7)}><rect x="320" y="222" width="160" height="44" rx="22" class="lx-fill" /><text x="400" y="250" class="lx-s lx-ink">Book a visit</text></g>
          <circle cx="440" cy="250" r="16" class="lx-line lx-bold x-pop x-out" style={d(7.2, 7.6)} />
          <text x="400" y="330" class="lx-h lx-h--l x-in" style={d(7.7)}>Tuesday, 10:30. Booked.</text>
        </>)}
        {id === 'ground' && (<>
          <rect x="120" y="50" width="560" height="310" pathLength="1" class="lx-line x-draw" style={d(0.2)} />
          <path d="M320 50 V220 M320 220 H680 M520 220 V360" pathLength="1" class="lx-line x-draw" style={d(0.8)} />
          <path d="M156 360 A26 26 0 0 1 204 360" class="lx-line lx-bold x-in" style={d(1.2)} />
          {([['Entrance', 180, 392], ['Reception', 220, 140], ['Waiting', 500, 140], ['Room 2', 640, 345]] as const).map(([t, x, y], k) => <text x={x} y={y} class="lx-s x-in" style={d(1.4 + k * 0.2)}>{t}</text>)}
          <path d="M180 350 L220 230 L420 190 L420 290 L600 270" pathLength="1" class="lx-line lx-path x-draw" style={d(3.0, undefined, '--t:4s')} />
          {([[220, 230, 'Welcome', 3.6, 238, 262, 'lx-start'], [420, 190, 'Take a seat', 4.8, 436, 178, 'lx-start'], [420, 290, 'This way', 5.8, 436, 322, 'lx-start']] as const).map(([x, y, t, s, tx, ty, al]) => (<>
            <g class="x-pop" style={d(s)}><rect x={x - 7} y={y - 7} width="14" height="14" transform={`rotate(45 ${x} ${y})`} class="lx-fill" /></g>
            <text x={tx} y={ty} class={`lx-s ${al} x-in`} style={d(s + 0.2)}>{t}</text>
          </>))}
          <circle cx="600" cy="270" r="16" class="lx-line lx-bold lx-glow x-pop" style={d(7.2)} />
        </>)}
        {id === 'artifacts' && (<>
          <g class="x-out" style={d(0, 5.8)}>
            <path d="M82 140 L82 130 L90 100 H144 L152 130 V90 Q152 70 172 70 H272 Q292 70 292 90 V130 L300 100 H354 L362 130 H502 V320 H362 L354 350 H300 L292 320 V360 Q292 380 272 380 H172 Q152 380 152 360 V320 L144 350 H90 L82 320 V310 L60 300 V150 Z" pathLength="1" class="lx-line x-draw" style={d(0.2, undefined, '--t:1.6s')} />
            <path d="M82 140 V310 M152 130 V320 M292 130 V320 M362 130 V320 M82 130 H152 M152 130 H292 M292 130 H362 M82 320 H152 M152 320 H292 M292 320 H362" class="lx-line lx-fold x-in" style={d(1.4)} />
            <text x="117" y="400" class="lx-tiny x-in" style={d(1.5)}>Side</text>
            <text x="222" y="400" class="lx-tiny x-in" style={d(1.5)}>Front</text>
            <text x="327" y="400" class="lx-tiny x-in" style={d(1.5)}>Side</text>
            <text x="432" y="400" class="lx-tiny x-in" style={d(1.5)}>Back</text>
            <g class="x-in" style={d(1.8)}><text x="172" y="190" textLength="100" lengthAdjust="spacing" class="lx-logo" style="font-size:21.7px">KNGHT</text><g transform="translate(172 192.01) scale(0.1667)"><circle cx="30" cy="60" r="16" class="lx-line" style="stroke-width:5" /><path d="M46 60 H120 M120 30 V90 M136 51 L530 51 L594 60 L530 69 L136 69 Z" class="lx-line" style="stroke-width:5" /></g></g>
            <text x="222" y="236" class="lx-tiny lx-tiny--w x-in" style={d(2.1)}>Hall candle</text>
            <text x="222" y="250" class="lx-tiny lx-tiny--w lx-it x-in" style={d(2.2)}>Bougie du hall</text>
            <text x="222" y="306" class="lx-tiny lx-tiny--w lx-nc x-in" style={d(2.3)}>200 g</text>
            <g class="x-in" style={d(2.3)}><text transform="rotate(-90 327 225)" x="327" y="229" class="lx-tiny lx-tiny--w lx-nc">Light the KNGHT</text></g>
            <g class="x-in" style={d(2.5)}>
              <text x="374" y="148" class="lx-tiny lx-tiny--w lx-nc lx-start">Smoke, steel, cedar</text>
              <text x="374" y="159" class="lx-tiny lx-tiny--w lx-it lx-start">Fumée, acier, cèdre</text>
              <text x="374" y="178" class="lx-tiny lx-start">Caution</text>
              <text x="374" y="189" class="lx-tiny lx-it lx-start">Mise en garde</text>
              <path d="M374 199 H490 M374 207 H482 M374 215 H488 M374 223 H460" class="lx-line lx-faint" />
              <text x="374" y="240" class="lx-tiny lx-start">KNGHT, Toronto ON</text>
            </g>
            <g transform="translate(-12 -6)"><g class="x-pop" style={d(2.8)}>
              <rect x="406" y="262" width="96" height="50" rx="2" class="lx-patch" />
              <path d="M416.0 268h0.8v31h-0.8zM417.6 268h0.8v31h-0.8zM419.2 268h0.8v31h-0.8zM420.8 268h3.2v31h-3.2zM425.6 268h1.6v26h-1.6zM428.8 268h0.8v26h-0.8zM430.4 268h0.8v26h-0.8zM433.6 268h1.6v26h-1.6zM436.8 268h1.6v26h-1.6zM440.0 268h0.8v26h-0.8zM441.6 268h0.8v26h-0.8zM444.8 268h1.6v26h-1.6zM448.0 268h1.6v26h-1.6zM451.2 268h0.8v26h-0.8zM452.8 268h0.8v31h-0.8zM454.4 268h0.8v31h-0.8zM456.0 268h1.6v26h-1.6zM459.2 268h1.6v26h-1.6zM461.6 268h1.6v26h-1.6zM464.0 268h1.6v26h-1.6zM467.2 268h0.8v26h-0.8zM471.2 268h0.8v26h-0.8zM472.8 268h0.8v26h-0.8zM474.4 268h2.4v26h-2.4zM478.4 268h0.8v26h-0.8zM480.8 268h2.4v26h-2.4zM484.0 268h1.6v31h-1.6zM486.4 268h1.6v31h-1.6zM489.6 268h0.8v31h-0.8zM491.2 268h0.8v31h-0.8z" class="lx-bars" />
              <text x="454" y="307" class="lx-code">6 14141 12345 2</text>
            </g></g>
            {(['Name on the front panel', 'Net quantity, metric, lower front', 'English and French', 'Caution, in both languages', 'Dealer name and address', 'GS1 barcode, back, lower right'] as const).map((t, k) => (<>
              <path d={`M540 ${132 + k * 36} l6 6 l12 -13`} pathLength="1" class="lx-line lx-bold x-draw" style={d(3.2 + k * 0.4, undefined, '--t:.3s')} />
              <text x="566" y={140 + k * 36} class="lx-li x-in" style={d(3.3 + k * 0.4)}>{t}</text>
            </>))}
          </g>
          <g transform="translate(-150 0)">
            <path d="M330 170 L420 130 L560 170 L470 210 Z M330 170 V310 L470 350 V210 M470 350 L560 310 V170" pathLength="1" class="lx-line x-draw" style={d(6.0, undefined, '--t:1.2s')} />
            <g class="x-in" style={d(6.8)}><g transform="matrix(1 .2857 0 1 0 0)">
              <text x="350" y="118" textLength="100" lengthAdjust="spacing" class="lx-logo" style="font-size:21.7px">KNGHT</text><g transform="translate(350 120.01) scale(0.1667)"><circle cx="30" cy="60" r="16" class="lx-line" style="stroke-width:5" /><path d="M46 60 H120 M120 30 V90 M136 51 L530 51 L594 60 L530 69 L136 69 Z" class="lx-line" style="stroke-width:5" /></g>
              <text x="400" y="156" class="lx-tiny lx-tiny--w">Hall candle</text>
              <text x="400" y="168" class="lx-tiny lx-tiny--w lx-it">Bougie du hall</text>
              <text x="400" y="205" class="lx-tiny lx-tiny--w lx-nc">200 g</text>
            </g></g>
            <text x="400" y="390" class="lx-tiny x-in" style={d(6.8)}>Front</text>
          </g>
          <g transform="translate(150 0)">
            <path d="M330 170 L420 130 L560 170 L470 210 Z M330 170 V310 L470 350 V210 M470 350 L560 310 V170" pathLength="1" class="lx-line x-draw" style={d(6.6, undefined, '--t:1.2s')} />
            <g class="x-in" style={d(7.4)}><g transform="matrix(1 .2857 0 1 0 0)">
              <text x="340" y="92" class="lx-tiny lx-tiny--w lx-nc lx-start">Smoke, steel, cedar</text>
              <text x="340" y="103" class="lx-tiny lx-tiny--w lx-it lx-start">Fumée, acier, cèdre</text>
              <text x="340" y="118" class="lx-tiny lx-start">Caution</text>
              <text x="340" y="129" class="lx-tiny lx-it lx-start">Mise en garde</text>
              <path d="M340 139 H458 M340 146 H450 M340 153 H455" class="lx-line lx-faint" />
              <text x="340" y="166" class="lx-tiny lx-nc lx-start">KNGHT, Toronto ON</text>
            </g></g>
            <g transform="matrix(1 .2857 0 1 0 0)"><g transform="translate(110.8 -11.4) scale(.7)"><g class="x-pop" style={d(7.9)}>
              <rect x="406" y="262" width="96" height="50" rx="2" class="lx-patch" />
              <path d="M416.0 268h0.8v31h-0.8zM417.6 268h0.8v31h-0.8zM419.2 268h0.8v31h-0.8zM420.8 268h3.2v31h-3.2zM425.6 268h1.6v26h-1.6zM428.8 268h0.8v26h-0.8zM430.4 268h0.8v26h-0.8zM433.6 268h1.6v26h-1.6zM436.8 268h1.6v26h-1.6zM440.0 268h0.8v26h-0.8zM441.6 268h0.8v26h-0.8zM444.8 268h1.6v26h-1.6zM448.0 268h1.6v26h-1.6zM451.2 268h0.8v26h-0.8zM452.8 268h0.8v31h-0.8zM454.4 268h0.8v31h-0.8zM456.0 268h1.6v26h-1.6zM459.2 268h1.6v26h-1.6zM461.6 268h1.6v26h-1.6zM464.0 268h1.6v26h-1.6zM467.2 268h0.8v26h-0.8zM471.2 268h0.8v26h-0.8zM472.8 268h0.8v26h-0.8zM474.4 268h2.4v26h-2.4zM478.4 268h0.8v26h-0.8zM480.8 268h2.4v26h-2.4zM484.0 268h1.6v31h-1.6zM486.4 268h1.6v31h-1.6zM489.6 268h0.8v31h-0.8zM491.2 268h0.8v31h-0.8z" class="lx-bars" />
