---
// The film: what KNGHT does, in six scenes of footage and drawn motion (src/scripts/film.js, film-motion.js).
// It plays by itself when it comes into view. Without motion it reads as a still diagram with the six lines.
import { getWorlds, getLayers } from '../lib/site';
import { SIGILS, WORLD_SIGILS } from '../lib/sigils';
const worlds = await getWorlds();
const layers = await getLayers();
const TAG: Record<string, string> = {
  lore: 'The story', law: 'Offers and claims', language: 'The voice', map: 'The site and search',
  ground: 'The space', artifacts: 'What people hold', machinery: 'The systems',
};
const RING = (k: number) => 64 + k * 50; // Law 114 ... Machinery 364
const ANG = [0, -64, 28, -150, 112, -28, 200]; // where each badge sits on its ring
const rad = (d: number) => (d * Math.PI) / 180;
const WR = 372;
// Three scenes are footage (black and white, made for this film); the other three are drawn live (film-motion.js).
// The shots live in public/footage, re-encoded from the generated originals as H.264 (8-bit, a keyframe every
// half second, metadata first) so they play in every browser and seek quickly. knght-footer in the same folder is not
// one of these shots: it is the homepage footer's spotlight ending (src/scripts/footer/scenes/spotlight.js).
const SHOTS: (string | null)[] = [
  '/footage/genesis.mp4',
  null,
  '/footage/forge.mp4',
  '/footage/hall.mp4',
  null,
  null,
];
// Where in each shot the diagram's core belongs (fractions of the frame), measured from the footage: the heart of
// the genesis cloud, and the point where the hammer meets the metal. The hall stays centred (its beam is matched).
// The hall's column of light is matched to the core too, sideways only ("-" leaves it level), so the light falls on the world.
const ANCHOR: Record<number, string> = { 0: '0.505 0.505 1.6', 2: '0.545 0.598 1.3', 3: '0.5 - 1.65' }; // x y, most it may be enlarged
// Under each world's name, what the business is: the rest of its name from its world file. Rum Raiders' second word is
// part of its name, so its category stands in.
const WHAT: Record<string, string> = { 'rum-raiders-ring': 'Spirits' };
const scenes = [
  { eb: 'What we do', h: ['Every', 'business', 'is a <em>world.</em>'], p: 'Your customers meet it everywhere: online, on the shelf and at the front desk.' },
  { eb: 'The layers', h: ['A world', 'is built in', '<em>seven layers.</em>'], p: 'We build all seven, from the story at its core to the systems that keep it running.' },
  { eb: 'The order', h: ['Built in order.', '<em>Lore first.</em>'], p: 'We start with the story, because everything else is built on it.' },
  { eb: 'The rules', h: ['All of it', 'inside', '<em>your rules.</em>'], p: 'Every word, sign and system is checked against <span data-reel-reg>your regulator</span>.' },
  { eb: 'The work', h: ['Most worlds', 'are missing', '<em>layers.</em>'], p: '' },
  { eb: 'The worlds', h: ['Nine worlds built.', '<em>Yours is next.</em>'], p: 'A free 30-minute call. Your three biggest risks, one fix for this week, and a straight answer on fit.' },
];
const LABELS = ['A world', 'Seven layers', 'In order', 'Your rules', 'The work', 'Nine worlds'];
---
<section class="film" id="reel" aria-labelledby="film-title">
  <h2 class="sr-only" id="film-title">What KNGHT does, in six scenes</h2>
  <div class="film__stage">
    <div class="film__plates" aria-hidden="true">
      {SHOTS.map((src, i) => src && <video class="film__plate" muted playsinline preload="none" data-src={src} data-i={i} data-anchor={ANCHOR[i]}></video>)}
      <canvas class="film__canvas"></canvas>
    </div>
    <div class="film__shade" aria-hidden="true"></div>
    <svg class="reel__svg film__gfx" viewBox="-500 -500 1000 1000" aria-hidden="true" data-role="img" aria-label="A world drawn as seven rings around a core: Lore at the centre, then Law, Language, Map, Ground, Artifacts and Machinery, all inside a boundary of your regulator's rules.">
      <defs>
        <radialGradient id="reelGlow"><stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset=".45" stop-color="#fff" stop-opacity=".05"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
        <!-- The boundary's words sit level: the claim across the top, the rest along the bottom, both upright. -->
        <path id="reelTop" d="M -452 0 A 452 452 0 0 1 452 0" />
        <path id="reelBottom" d="M -466 0 A 466 466 0 0 0 466 0" />
      </defs>
      <circle class="reel__halo" r="480" fill="url(#reelGlow)" />
      <g class="reel__world">
        <g class="reel__law">
          <circle class="reel__bound" r="430" />
          <text class="reel__lawtext" text-anchor="middle"><textPath href="#reelTop" startOffset="50%" data-reel-path>CHECKED AGAINST YOUR REGULATOR</textPath></text>
          <text class="reel__lawtext" text-anchor="middle"><textPath href="#reelBottom" startOffset="50%">EVERY WORD · EVERY SIGN · EVERY SYSTEM</textPath></text>
        </g>
        <g class="reel__core">
          <circle class="reel__pulse" r="58" />
          <circle class="reel__corec" r="58" />
          <g transform="translate(-24 -24) scale(2)" class="reel__sig" set:html={SIGILS.lore} />
          <text class="reel__name reel__name--core" y="94">Lore</text>
        </g>
        {layers.slice(1).map((l, i) => {
          const k = i + 1, R = RING(k), a = ANG[k], top = k === 1; // Law sits just above the core: its words go above its chip, clear of Lore
          return (
            <g class="reel__layer" data-k={k}>
              <path class="reel__ring" data-r={R} d={`M ${R} 0 A ${R} ${R} 0 1 1 ${-R} 0 A ${R} ${R} 0 1 1 ${R} 0`} />
              <g class="reel__orbit" data-speed={(k % 2 ? 1 : -1) * (60 + k * 18)}>
                <g transform={`translate(${(Math.cos(rad(a)) * R).toFixed(1)} ${(Math.sin(rad(a)) * R).toFixed(1)})`}>
                  <g class="reel__badge">
                    <circle class="reel__chip" r="25" />
                    <g transform="translate(-14.4 -14.4) scale(1.2)" class="reel__sig" set:html={SIGILS[l.id] || ''} />
                    <text class="reel__name" y={top ? -66 : 48}>{l.data.name}</text>
                    <text class="reel__tag" y={top ? -44 : 70}>{TAG[l.id]}</text>
                  </g>
                </g>
              </g>
            </g>
          );
        })}
      </g>
      <g class="reel__worlds">
        {worlds.map((w, i) => {
          const a = rad(-90 + (i * 360) / (worlds.length + 1)); // one seat more than there are worlds, left empty
          const x = Math.cos(a) * WR, y = Math.sin(a) * WR;
          return (
            <g class="reel__wl" data-i={i}>
              <line class="reel__spoke" x1="0" y1="0" x2={x.toFixed(1)} y2={y.toFixed(1)} />
              <a href={`/worlds/${w.id}/`} tabindex="-1" class="reel__wa">
                <g transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
                  <g class="reel__wb">
                    <circle class="reel__chip" r="40" />
                    <g transform="translate(-21.6 -21.6) scale(1.8)" class="reel__sig" set:html={WORLD_SIGILS[w.id] || ''} />
                    <text class={`reel__name ${y > 0 ? 'reel__name--below' : 'reel__name--above'}`} y={y > 0 ? 70 : -78}>{w.data.name}</text>
                    <text class="reel__tag reel__what" y={y > 0 ? 94 : -54}>{WHAT[w.id] ?? w.data.em}</text>
                  </g>
                </g>
              </a>
            </g>
          );
        })}
        {(() => {
          // The empty seat: the next world, the viewer's.
          const a = rad(-90 + (worlds.length * 360) / (worlds.length + 1)), x = Math.cos(a) * WR, y = Math.sin(a) * WR;
          return (
            <g class="reel__wl reel__seat" data-i={worlds.length}>
              <line class="reel__spoke" x1="0" y1="0" x2={x.toFixed(1)} y2={y.toFixed(1)} />
              <a href="/book/" tabindex="-1" class="reel__wa" aria-label="Yours is next: book the free call">
                <g transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
                  <g class="reel__wb">
                    <g class="reel__seatg">
                      <circle class="reel__hit" r="72" />
                      <circle class="reel__ping" r="40" />
                      <circle class="reel__ping reel__ping--late" r="40" />
                      <circle class="reel__chip" r="40" />
                      <path class="reel__plus" d="M-11 0H11M0 -11V11" />
                      <text class="reel__name" y={y > 0 ? 70 : -56}>Yours</text>
                    </g>
                  </g>
                </g>
              </a>
            </g>
          );
        })()}
      </g>
    </svg>
    <div class="film__type">
      {scenes.map((c, i) => (
        <div class="film__scene" data-scene={i}>
          <p class="eyebrow"><span class="reel__no">{String(i + 1).padStart(2, '0')}</span> {c.eb}</p>
          <p class="film__h display">{c.h.map((line) => <span class="film__line"><span class="film__in" set:html={line} /></span>)}</p>
          {c.p && <p class="film__p" set:html={c.p} />}
          {i === 4 && (
            <ol class="film__steps">
              <li><b>The Verdict</b><span>finds them</span></li>
              <li><b>The Build</b><span>fills them</span></li>
              <li><b>The Keep</b><span>keeps them running</span></li>
            </ol>
          )}
          {i === 5 && <a class="btn film__cta" href="/book/" data-magnetic>Book the free call <svg class="arrow" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></a>}
        </div>
      ))}
    </div>
    <div class="film__ui">
      <button type="button" class="film__play" data-film-play aria-label="Pause the film"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pause" d="M8 5v14M16 5v14"/><path class="i-play" d="M7 4.5v15l12-7.5z"/></svg></button>
      <div class="film__bar">
        <div class="film__fill" data-film-fill></div>
        {LABELS.map((l, i) => <button type="button" class="film__tick" data-film-tick={i} style={`--p:${([0, 8, 17, 25, 33, 42][i] / 49).toFixed(4)}`} aria-label={`Scene ${i + 1}: ${l}`}><span>{l}</span></button>)}
      </div>
      <button type="button" class="film__replay" data-film-replay>Watch again</button>
    </div>
  </div>
</section>
