---
// The showreel: what KNGHT does, in six scenes driven by scroll (src/scripts/reel.js).
// Without motion it reads as a still diagram with the six lines beneath it.
import { getWorlds, getLayers } from '../lib/site';
import { SIGILS, WORLD_SIGILS } from '../lib/sigils';
const worlds = await getWorlds();
const layers = await getLayers();
const TAG: Record<string, string> = {
  lore: 'The story', law: 'The rules', language: 'The voice', map: 'The site and search',
  ground: 'The space', artifacts: 'What people hold', machinery: 'The systems',
};
const RING = (k: number) => 64 + k * 50; // Law 114 ... Machinery 364
const ANG = [0, -64, 28, -150, 112, -28, 200]; // where each badge sits on its ring
const rad = (d: number) => (d * Math.PI) / 180;
const WR = 372;
const caps = [
  { eb: 'What we do', h: 'Every business is a <em>world.</em>', p: 'Not a logo. A whole place your customers step into, online and in person.' },
  { eb: 'The layers', h: 'A world is built in <em>seven layers.</em>', p: 'From the story at its core to the systems that keep it running.' },
  { eb: 'The order', h: 'Built in order. <em>Lore first.</em>', p: 'Each layer holds up the next. Skip one and the rest wobble.' },
  { eb: 'The rules', h: 'All of it inside <em>your rules.</em>', p: 'Every word, sign and system is checked against <span data-reel-reg>your regulator</span>.' },
  { eb: 'The work', h: 'Most worlds are <em>missing layers.</em>', p: '<b>The Verdict</b> finds them. <b>The Build</b> fills them. <b>The Keep</b> keeps them running.' },
  { eb: 'The worlds', h: 'Nine worlds, <em>built so far.</em>', p: 'Clinics, law, spirits, food and more. Step inside.' },
];
---
<section class="reel" id="reel" aria-labelledby="reel-h0">
  <div class="reel__pin">
    <div class="wrap reel__grid">
      <div class="reel__caps">
        {caps.map((c, i) => (
          <div class="reel__cap" data-cap={i}>
            <p class="eyebrow"><span class="reel__no">{String(i + 1).padStart(2, '0')}</span> {c.eb}</p>
            <h2 class="display reel__h" id={`reel-h${i}`} set:html={c.h} />
            <p class="reel__p" set:html={c.p} />
          </div>
        ))}
        <p class="reel__count" aria-hidden="true"><b data-reel-n>01</b> / 06</p>
      </div>
      <div class="reel__stage">
        <svg class="reel__svg" viewBox="-500 -500 1000 1000" role="img" aria-label="A world drawn as seven rings around a core: Lore at the centre, then Law, Language, Map, Ground, Artifacts and Machinery, all inside a boundary of your regulator's rules.">
          <defs>
            <radialGradient id="reelGlow"><stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset=".45" stop-color="#fff" stop-opacity=".05"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
            <path id="reelArc" d="M 0 -452 A 452 452 0 1 1 -0.1 -452" />
          </defs>
          <circle class="reel__halo" r="480" fill="url(#reelGlow)" />
          <g class="reel__world">
            <g class="reel__law">
              <circle class="reel__bound" r="430" />
              <text class="reel__lawtext"><textPath href="#reelArc" data-reel-path>CHECKED AGAINST YOUR REGULATOR · EVERY WORD · EVERY SIGN · EVERY SYSTEM · CHECKED AGAINST YOUR REGULATOR · EVERY WORD · EVERY SIGN · EVERY SYSTEM ·</textPath></text>
            </g>
            <g class="reel__core">
              <circle class="reel__pulse" r="58" />
              <circle class="reel__corec" r="58" />
              <g transform="translate(-24 -24) scale(2)" class="reel__sig" set:html={SIGILS.lore} />
              <text class="reel__name reel__name--core" y="94">Lore</text>
            </g>
            {layers.slice(1).map((l, i) => {
              const k = i + 1, R = RING(k), a = ANG[k];
              return (
                <g class="reel__layer" data-k={k}>
                  <circle class="reel__ring" r={R} />
                  <g class="reel__orbit" data-speed={(k % 2 ? 1 : -1) * (60 + k * 18)}>
                    <g transform={`translate(${(Math.cos(rad(a)) * R).toFixed(1)} ${(Math.sin(rad(a)) * R).toFixed(1)})`}>
                      <g class="reel__badge">
                        <circle class="reel__chip" r="25" />
                        <g transform="translate(-14.4 -14.4) scale(1.2)" class="reel__sig" set:html={SIGILS[l.id] || ''} />
                        <text class="reel__name" y="48">{l.data.name}</text>
                        <text class="reel__tag" y="70">{TAG[l.id]}</text>
                      </g>
                    </g>
                  </g>
                </g>
              );
            })}
          </g>
          <g class="reel__worlds">
            {worlds.map((w, i) => {
              const a = rad(-90 + (i * 360) / worlds.length);
              const x = Math.cos(a) * WR, y = Math.sin(a) * WR;
              return (
                <g class="reel__wl" data-i={i}>
                  <line class="reel__spoke" x1="0" y1="0" x2={x.toFixed(1)} y2={y.toFixed(1)} />
                  <a href={`/worlds/${w.id}/`} tabindex="-1" class="reel__wa">
                    <g transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
                      <g class="reel__wb">
                        <circle class="reel__chip" r="40" />
                        <g transform="translate(-21.6 -21.6) scale(1.8)" class="reel__sig" set:html={WORLD_SIGILS[w.id] || ''} />
                        <text class="reel__name" y={y > 0 ? 70 : -56}>{w.data.name}</text>
                      </g>
                    </g>
                  </a>
                </g>
              );
            })}
          </g>
        </svg>
      </div>
    </div>
    <p class="reel__hint" aria-hidden="true"><span></span>Scroll</p>
  </div>
</section>
