---
// The closing call to action on inner pages.
interface Props { line?: string; score?: string | false }
const { line = 'Fixed fee from $3,500 CAD. Scored report in 5 business days. Fee credited to your Build within 60 days.', score = '/#score' } = Astro.props;
---
<section class="wcta">
  <div class="wrap">
    <h2 class="display" data-split>Every world starts <br>with a <em class="sheen">Verdict.</em></h2>
    <p>{line}</p>
    <div class="actions">
      <a class="btn" href="/book/" data-magnetic>Book the free call
        <svg class="arrow" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </a>
      {score && <a class="link" href={score}>Score your world first</a>}
      <slot />
    </div>
  </div>
</section>
