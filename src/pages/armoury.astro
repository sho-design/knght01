---
// The armoury: KNGHT's free tools, one for each of the seven layers.
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { SIGILS } from '../lib/sigils';
type Tool = { name: string; href?: string; promise: string };
const LAYERS: { id: string; name: string; tools: Tool[] }[] = [
  { id: 'lore', name: 'Lore', tools: [{ name: 'The one-line forge', promise: 'Who you serve, what you change, what you refuse. One line the whole team can repeat.' }] },
  { id: 'law', name: 'Law', tools: [{ name: 'The claim checker', href: '/check/', promise: 'Paste an ad or a label. See the words a regulator would question, and a safer way to say them.' }] },
  { id: 'language', name: 'Language', tools: [
    { name: 'The reply scribe', href: '/reply/', promise: 'Answer every review. Give nothing away.' },
    { name: 'The plain-speech test', promise: 'Strike the filler and the words that sound like a machine wrote them.' }] },
  { id: 'map', name: 'Map', tools: [{ name: 'The cartographer', promise: 'A guided check of your Google Business Profile, with the fixes in order.' }] },
  { id: 'ground', name: 'Ground', tools: [
    { name: 'The herald', href: '/herald/', promise: 'QR signs that never expire, framed in your own arms and tested before you print.' },
    { name: 'Waymarks', promise: 'A matching set of signs for your space: wait here, this way, room two.' }] },
  { id: 'artifacts', name: 'Artifacts', tools: [{ name: 'Your sigil', href: '/sigil/', promise: 'A crest forged from your name, with a video, a livery kit and a link that re-forges it anywhere.' }] },
  { id: 'machinery', name: 'Machinery', tools: [
    { name: 'The leak', href: '/leak/', promise: 'What your missed calls cost in a year, from your own numbers.' },
    { name: 'The licence keep', href: '/keep/', promise: 'Every renewal on one wall, with reminders 90, 30 and 7 days ahead.' }] },
];
const live = LAYERS.flatMap((l) => l.tools.filter((t) => t.href));
const ld = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: 'KNGHT free tools', itemListElement: live.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: `https://knght.com${t.href}` })) }];
---
<Base title="Free tools for regulated businesses | KNGHT" description="Free tools for Ontario clinics, law firms, medspas, spirits and food businesses: a claim checker, a review reply writer, QR signs that never expire, a renewal keep and more. All run in your browser." path="armoury/" ld={ld}>
  <section class="whero ck-hero">
    <div class="wrap">
      <p class="eyebrow">The armoury</p>
      <h1 class="display book__title" style="margin-top:24px">A tool for <br><em>every layer.</em></h1>
      <p class="for__answer">A world is built in seven layers. Here is something you can use today for each one. Free, no sign-up, and every tool runs in your browser, so nothing you type is sent anywhere.</p>
    </div>
  </section>

  <section class="wsec arm-sec">
    <div class="wrap">
      <ol class="arm">
        {LAYERS.map((l, i) => (
          <li class="arm__layer">
            <div class="arm__head">
              <svg class="arm__sig" viewBox="0 0 24 24" aria-hidden="true" set:html={SIGILS[l.id] || ''} />
              <span class="arm__num">{String(i + 1).padStart(2, '0')}</span>
              <a class="arm__name" href={`/layers/${l.id}/`}>{l.name}</a>
            </div>
            <ul class="arm__tools">
              {l.tools.map((t) => t.href ? (
                <li><a class="arm__tool" href={t.href}><b>{t.name}</b><span>{t.promise}</span><svg class="arrow" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg></a></li>
              ) : (
                <li><div class="arm__tool is-forging"><b>{t.name}</b><span>{t.promise}</span><em>Being forged</em></div></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Cta line="The tools handle one job each. A Verdict reads all seven layers of your world, from $3,500 CAD, in 5 business days." />
</Base>
