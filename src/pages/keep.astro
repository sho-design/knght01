---
// The licence keep: renewal dates as seals on a wall, and a calendar file with reminders (public/assets/js/keep.js).
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
const CATS = [['clinic', 'Clinics'], ['dental', 'Dental'], ['medspa', 'Medspas'], ['law', 'Law firms'], ['spirits', 'Spirits'], ['food', 'Food and drink'], ['other', 'Something else']];
const ld = [{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'KNGHT licence keep', applicationCategory: 'BusinessApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'CAD' },
  description: 'List your licences, registrations and insurance renewal dates and download a calendar file with reminders 90, 30 and 7 days ahead.' }];
---
<Base title="Free licence and renewal reminder calendar | KNGHT" description="List your licences, college registration, insurance and domain renewals. Get a calendar file with reminders 90, 30 and 7 days ahead. Free, runs in your browser." path="keep/" ld={ld}>
  <Fragment slot="scripts"><script is:inline src="/assets/js/keep.js" defer></script></Fragment>
  <section class="whero ck-hero">
    <div class="wrap">
      <p class="eyebrow">The licence keep</p>
      <h1 class="display book__title" style="margin-top:24px">Never let a <br><em>seal break.</em></h1>
      <p class="for__answer">List what has to be renewed: registrations, licences, insurance, your domain. Each one becomes a seal on the wall, and you get a calendar file that reminds you 90, 30 and 7 days ahead. It stays in your browser, and what you list stays on your device.</p>
      <form class="ck kp" data-keep novalidate>
        <div class="ck__cats" role="group" aria-label="Start from a list"><span class="ck__lbl">Start from a list</span>{CATS.map(([v, l]) => <button type="button" class="cat" data-keep-cat={v}>{l}</button>)}</div>
        <ol class="kp__rows" data-keep-rows></ol>
        <div class="ck__actions">
          <button type="button" class="link" data-keep-add>Add another</button>
          <label class="kp__yearly"><input type="checkbox" data-keep-yearly checked> Repeat every year</label>
        </div>
      </form>
    </div>
  </section>

  <section class="wsec kp-out" data-keep-out hidden>
    <div class="wrap">
      <p class="eyebrow">Your keep</p>
      <p class="ck__sum" data-keep-sum></p>
      <figure class="kp__wall" data-keep-wall></figure>
      <div class="ck__actions">
        <button type="button" class="btn" data-keep-ics>Add to my calendar</button>
        <button type="button" class="link" data-keep-forget>Forget this list</button>
      </div>
      <p class="kp__how">Opens in Google Calendar, Apple Calendar and Outlook. You get a reminder 90, 30 and 7 days before each date, and on the day.</p>
      <p class="ck__note">Saved only in this browser so it&rsquo;s here next time. Check each date against the notice from your regulator or insurer. Some renewals open weeks before they&rsquo;re due.</p>
    </div>
  </section>

  <section class="wsec"><div class="wrap wsec__grid"><p class="eyebrow">Why it matters</p>
    <ul class="wrules">
      <li><b>A lapse stops the work</b><span>Practising, selling or serving without a current registration or licence can mean stopping until it&rsquo;s fixed, and explaining why.</span></li>
      <li><b>Insurance gaps are silent</b><span>Nobody calls when cover ends. You find out when you need it.</span></li>
      <li><b>Your domain is your front door</b><span>Let it lapse and your website and email can go dark overnight.</span></li>
    </ul>
  </div></section>

  <Cta line="The keep watches the dates. A Build sets up the machinery that runs the rest: bookings, reminders and reviews, without anyone chasing." />
</Base>
