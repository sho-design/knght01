---
// The leak: what missed calls and messages cost in a year, from the visitor's own numbers (public/assets/js/leak.js).
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
const CATS = [['clinic', 'Clinic'], ['dental', 'Dental'], ['medspa', 'Medspa'], ['law', 'Law firm'], ['spirits', 'Spirits'], ['food', 'Food and drink'], ['other', 'Something else']];
const ld = [{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'KNGHT leak calculator', applicationCategory: 'BusinessApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'CAD' },
  description: 'Work out what missed calls and unanswered messages cost your business in a year, using your own numbers.' }];
---
<Base title="What do missed calls cost you? A free calculator | KNGHT" description="Enter your missed calls, how many would have booked and what a new client is worth. See what slips away in a year, and what faster replies would recover. Free, runs in your browser." path="leak/" ld={ld}>
  <Fragment slot="scripts"><script is:inline src="/assets/js/leak.js" defer></script></Fragment>
  <section class="whero ck-hero">
    <div class="wrap">
      <p class="eyebrow">The leak</p>
      <h1 class="display book__title" style="margin-top:24px">What slips away <br><em>while you&rsquo;re busy.</em></h1>
      <p class="for__answer">Every missed call and unanswered message is someone who wanted to book. Put in your own numbers and watch a year run through the glass. Your numbers stay on your device. Analytics sees only your category and the result, in broad bands.</p>
    </div>
  </section>

  <section class="wsec lk-sec">
    <div class="wrap lk">
      <form class="lk__form" data-leak novalidate>
        <div class="ck__cats" role="group" aria-label="Your category"><span class="ck__lbl">Start from an example</span>{CATS.map(([v, l]) => <button type="button" class="cat" data-leak-cat={v} aria-pressed="false">{l}</button>)}</div>
        <label class="lk__row"><span class="lk__q">Missed calls and unanswered messages in a week</span><span class="lk__in"><input type="number" name="missed" min="0" max="999" step="1" inputmode="numeric"></span><em class="lk__hint">Count last week: missed calls, voicemails, form fills and DMs that waited more than an hour.</em></label>
        <label class="lk__row"><span class="lk__q">Of those, how many would have booked</span><span class="lk__in"><input type="number" name="rate" min="0" max="100" step="1" inputmode="numeric"><i>%</i></span><em class="lk__hint">Be honest. Some were sales calls and wrong numbers.</em></label>
        <label class="lk__row"><span class="lk__q">What a new client is worth in their first year</span><span class="lk__in"><i>$</i><input type="number" name="value" min="0" max="1000000" step="10" inputmode="numeric"></span><em class="lk__hint">Their first visit plus the visits that usually follow in a year.</em></label>
        <label class="lk__row"><span class="lk__q">Weeks you&rsquo;re open in a year</span><span class="lk__in"><input type="number" name="weeks" min="1" max="52" step="1" inputmode="numeric"></span></label>
        <label class="lk__row lk__row--slide"><span class="lk__q">How many you could catch with faster replies</span><span class="lk__in lk__in--slide"><input type="range" name="catch" min="0" max="100" step="5"><output data-leak-catch></output></span><em class="lk__hint">An answering line, a text-back when you miss a call, a reply within minutes.</em></label>
      </form>

      <div class="lk__out" aria-live="polite">
        <figure class="lk__glass" data-leak-glass aria-hidden="true"></figure>
        <div class="lk__read">
          <p class="lk__lbl">Slips away in a year</p>
          <p class="lk__big" data-leak-year>$0</p>
          <p class="lk__sub" data-leak-sub></p>
          <p class="lk__lbl lk__lbl--gap">Faster replies would recover</p>
          <p class="lk__mid" data-leak-save>$0</p>
          <p class="lk__note">Your numbers, not ours. The examples are only a place to start.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wsec"><div class="wrap wsec__grid"><p class="eyebrow">Where it leaks</p>
    <ul class="wrules">
      <li><b>After hours</b><span>People book when they have a minute, which is often when you&rsquo;re closed. A text-back keeps them from calling the next name on the list.</span></li>
      <li><b>During appointments</b><span>The phone rings while everyone is with a client. That&rsquo;s when a missed call should answer itself.</span></li>
      <li><b>Forms and DMs</b><span>A message that waits a day is usually a client who booked somewhere else.</span></li>
      <li><b>The follow-up</b><span>No reminder, no rebooking, no review ask. Each is a quiet leak of its own.</span></li>
    </ul>
    <p class="wrules__more"><a class="link" href="/layers/machinery/">How we fix it: the Machinery layer</a></p>
  </div></section>

  <Cta line="The leak shows the cost. A Build fixes it: bookings, reminders, text-backs and review asks that run without anyone chasing." />
</Base>
