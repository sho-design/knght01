---
import Motion from '../components/Motion.astro';
import { SETTINGS } from '../lib/settings';
// The home page. World cards, the layer filter and the layer list come from the content files.
import Meter from '../components/Meter.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { CDN, CATEGORY, ROMAN, getWorlds, getLayers, worldLayers, workImages } from '../lib/site';
const worlds = await getWorlds();
const layers = await getLayers();
const drawers: Record<string, { label: string; target: number; imgs: Awaited<ReturnType<typeof workImages>> }> = {
  Artifacts: { label: 'Things you can hold', target: 2.8, imgs: await workImages('Artifacts') },
  Ground: { label: 'Rooms you can walk into', target: 2.6, imgs: await workImages('Ground') },
};
const SQUIRE = "<div class=\"layer__ai\" id=\"ai\"><p class=\"layer__ai-h\">AI is the squire, <em>not the knight.</em></p><p class=\"layer__ai-p\">AI answers, books, reminds and drafts, so your team gets its hours back. It never makes the call. In use at <a class=\"link\" href=\"/worlds/restoration-medical/\">Restoration Medical</a>.</p><ul class=\"layer__ai-list\"><li><b>What it does</b><span>Answers common questions, books and reminds, follows up, sorts intake and writes the first draft.</span></li><li><b>What it never does</b><span>Make a claim your regulator has not cleared, give medical or legal advice, or touch health information outside tools set up for it.</span></li><li><b>Who checks it</b><span>A person, every time. AI drafts. Someone on your team signs.</span></li></ul><p class=\"layer__ai-more\"><a class=\"link\" href=\"/rules/clinics-ai-and-patient-information/\">Can your clinic put patient information into ChatGPT?</a></p></div>";
---
<!doctype html>
<html lang="en-CA" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Branding Agency for Regulated Businesses in Toronto | KNGHT</title>
<meta name="description" content="Brand worlds for Ontario clinics, dentists, medspas, law firms, spirits and food, built inside your regulator's rules. Verdict from $3,500. Free call.">
<meta name="theme-color" content="#000000">
<!-- Site settings come from src/lib/settings.ts -->
<meta name="knght:intake" content={SETTINGS.intake}>
<meta name="knght:form-endpoint" content={SETTINGS.formEndpoint}>
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="https://knght.com/">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="text/plain" href="/llms.txt" title="KNGHT for language models">
<meta property="og:title" content="Branding Agency for Regulated Businesses in Toronto | KNGHT">
<meta property="og:description" content="We build brand worlds for businesses that can't afford to get it wrong.">
<meta property="og:url" content="https://knght.com/">
<meta property="og:type" content="website">
<meta property="og:image" content="https://knght.com/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="KNGHT: We build brand worlds for businesses that can't afford to get it wrong.">
<meta property="og:site_name" content="KNGHT">
<meta property="og:locale" content="en_CA">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Branding Agency for Regulated Businesses in Toronto | KNGHT">
<meta name="twitter:description" content="We build brand worlds for businesses that can't afford to get it wrong.">
<meta name="twitter:image" content="https://knght.com/og.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="preload" as="image" href="https://d2ol7oe51mr4n9.cloudfront.net/user_2vgr4LDcTnBdquYG4fMZ396AWcW/223108b7-727b-4f95-83b3-b35e44c577ba.jpg">
<link rel="stylesheet" href="/assets/css/site.css">
<script is:inline>document.documentElement.classList.replace('no-js','js');if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('gsap')</script>
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "KNGHT",
  "url": "https://knght.com/",
  "logo": "https://knght.com/icon-512.png",
  "image": "https://knght.com/og.jpg",
  "email": "sho@knght.com",
  "description": "Brand worldbuilding studio for regulated consumer businesses in Ontario: clinics, dental clinics, medspas, law firms, spirits, and food and drink.",
  "areaServed": "Ontario, Canada",
  "address": { "@type": "PostalAddress", "addressLocality": "Toronto", "addressRegion": "ON", "addressCountry": "CA" },
  "founder": { "@type": "Person", "name": "Sergio Ho", "jobTitle": "Founder and creative director", "worksFor": { "@type": "Organization", "name": "KNGHT" } },
  "makesOffer": [
    { "@type": "Offer", "name": "The Verdict", "description": "A scored audit of an existing brand world, judged layer by layer against the buyer and the regulator. Scored report in 5 business days from the kickoff call. Fee credited to a Build started within 60 days.", "priceSpecification": { "@type": "PriceSpecification", "minPrice": 3500, "priceCurrency": "CAD" } },
    { "@type": "Offer", "name": "The Build: a full world", "description": "A complete brand world from zero, all seven layers, from $25,000 CAD, delivered ready to launch. The Verdict fee is credited in full to a Build started within 60 days.", "priceSpecification": { "@type": "PriceSpecification", "minPrice": 25000, "priceCurrency": "CAD" } },
    { "@type": "Offer", "name": "The Build: single layers", "description": "Only the layers your world is missing, from $7,500 CAD a layer.", "priceSpecification": { "@type": "UnitPriceSpecification", "minPrice": 7500, "priceCurrency": "CAD", "unitText": "layer" } },
    { "@type": "Offer", "name": "The Keep", "description": "Monthly running of the world after launch, from $4,500 CAD a month: content, signage, campaigns, new locations and products. Ad spend and printing billed separately.", "priceSpecification": { "@type": "UnitPriceSpecification", "minPrice": 4500, "priceCurrency": "CAD", "unitText": "MONTH" } }
  ]
}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<div class="loader" aria-hidden="true">
  <div class="loader__inner">
    <svg viewBox="0 0 120 600">
      <circle cx="60" cy="28" r="14" pathLength="1"/>
      <path class="d2" d="M54 44 V124 M66 44 V124" pathLength="1"/>
      <path class="d3" d="M6 124 Q20 136 34 130 H86 Q100 136 114 124" pathLength="1"/>
      <path class="d4" d="M50 142 L50 512 L60 584 L70 512 L70 142 Z" pathLength="1"/>
    </svg>
    <div class="loader__word"><span>K</span><span>N</span><span>G</span><span>H</span><span>T</span></div>
  </div>
  <div class="loader__count">000</div>
</div>

<div class="grain" aria-hidden="true"></div>

<header class="nav">
  <div class="wrap">
    <a class="mark" href="#top" aria-label="KNGHT home">
      <svg viewBox="0 27 600 66" aria-hidden="true"><circle cx="30" cy="60" r="16"/><path d="M46 60 H120 M120 30 V90 M136 51 L530 51 L594 60 L530 69 L136 69 Z"/></svg>
      KNGHT
    </a>
    <nav aria-label="Primary">
      <ul>
        <li><a href="#worlds">Worlds</a></li>
        <li><a href="#layers">The layers</a></li>
        <li><a href="#score">Score your world</a></li>
        <li><a href="#engage">Work with us</a></li><li><a href="/process/">How it works</a></li><li><a href="/rules/">Rules</a></li>
      </ul>
    </nav>
    <div class="nav__end">
      <button type="button" class="sound" data-sound aria-pressed="false" aria-label="Sound off. Turn sound on"><span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="sound__label">Sound</span></button>
      <a class="btn btn--sm" href="/book/" data-magnetic>Book the free call</a>
    </div>
  </div>
</header>

<main id="main">

  <!-- I. Hero -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__media" aria-hidden="true">
      <video autoplay muted loop playsinline preload="auto" data-scrub-src="https://d2ol7oe51mr4n9.cloudfront.net/user_2vgr4LDcTnBdquYG4fMZ396AWcW/e564eff6-2de7-4e88-84f5-b03eac1f5342.mp4" poster="https://d2ol7oe51mr4n9.cloudfront.net/user_2vgr4LDcTnBdquYG4fMZ396AWcW/223108b7-727b-4f95-83b3-b35e44c577ba.jpg">
        <source src="https://d2ol7oe51mr4n9.cloudfront.net/user_2vgr4LDcTnBdquYG4fMZ396AWcW/d7382d63-0629-4e84-a154-32250d837424.mp4" type="video/mp4">
      </video>
    </div>

    <div class="hero__meta" data-hero-fade>
      <span>Toronto, Ontario</span>
      <span>43.65&deg; N, 79.38&deg; W</span>
      <span data-clock>&nbsp;</span>
      <span class="hero__intake" data-intake hidden></span>
    </div>

    <div class="hero__inner wrap">
      <p class="eyebrow" data-hero-fade>Regulated by a college, a ministry or the AGCO</p>
      <h1 class="hero__title" id="hero-title">
        <span class="line"><span>We build</span></span>
        <span class="line"><span>brand worlds</span></span>
        <span class="line"><span>for businesses</span></span>
        <span class="line"><span>that can&rsquo;t afford</span></span>
        <span class="line"><span>to <em class="sheen">get it wrong.</em></span></span>
      </h1>
      <div class="cats" data-hero-fade>
        <div class="cats__row" role="group" aria-label="Choose your category">
          <span class="cats__label">Read it for</span>
          <button type="button" class="cat" data-cat="clinic" aria-pressed="false">Clinics</button>
          <button type="button" class="cat" data-cat="dental" aria-pressed="false">Dental</button>
          <button type="button" class="cat" data-cat="medspa" aria-pressed="false">Medspas</button>
          <button type="button" class="cat" data-cat="law" aria-pressed="false">Law firms</button>
          <button type="button" class="cat" data-cat="spirits" aria-pressed="false">Spirits</button>
                    <button type="button" class="cat" data-cat="food" aria-pressed="false">Food and drink</button>
        </div>
        <p class="cats__rules" data-cat-rules aria-live="polite">Pick your category. The page reads itself against your rules.</p>
      </div>
      <div class="hero__foot" data-hero-fade>
        <p class="hero__lede"><strong>A brand world is the whole business, built as one:</strong> the name, the voice, the site, the space, the print and the systems. All of it inside your Ontario regulator&rsquo;s rules. Agency-grade, without the $50,000 minimum.</p>
        <div class="actions">
          <a class="btn" href="/book/" data-magnetic>Book the free call
            <svg class="arrow" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
          </a>
          <a class="link" href="#worlds">See the worlds</a>
        </div>
        <p class="hero__micro">Free 30-minute call · No obligation</p>
      </div>
    </div>
  </section>

  <!-- Thesis -->
  <section class="thesis" aria-label="Why KNGHT">
    <div class="wrap">
      <div class="thesis__aside">
        <p class="eyebrow">The stakes</p>
        <ul class="thesis__stats" data-reveal>
          <li><b data-world-total-num>9</b><span>worlds built by our founder</span></li>
          <li><b>7</b><span>layers, built in order, inside the rules of your category</span></li>
          <li><b>1</b><span>Verdict, where every world starts</span></li>
        </ul>
      </div>
      <p class="thesis__text">Clinics, dentists, medspas, law firms, spirits, food and drink. Categories where <em>one wrong word costs a licence</em> and <em>one weak launch costs a year.</em> So we build the whole world, and every layer of it inside the rules. <span class="thesis__not">We are not an agency that hands you a logo and leaves.</span></p>
    </div>
  </section>

  <!-- II. Worlds -->
  <section class="worlds" id="worlds" aria-labelledby="worlds-title">
    <div class="worlds__pin">
      <div class="worlds__head wrap" style="width:100%">
        <p class="eyebrow">Worlds built by KNGHT&rsquo;s founder</p>
        <p class="worlds__count" aria-hidden="true"><b>I</b> / <span data-world-total>IX</span></p>
      </div>
      <div class="worlds__track">
        <div class="worlds__intro">
          <h2 class="display" id="worlds-title" data-split>Worlds</h2>
          <p data-reveal>Every world here was built by Sergio Ho, KNGHT&rsquo;s founder. Some we run. All were built inside the rules. Covers are mood plates. The work is inside each world.</p>
          <div class="wfilter" role="group" aria-label="Show worlds by layer"><button type="button" class="wfilter__chip" aria-pressed="true" data-layer="">All</button>{layers.filter((l) => worlds.some((w) => w.data.built[l.data.name])).map((l) => <button type="button" class="wfilter__chip" aria-pressed="false" data-layer={l.id}>{l.data.name}</button>)}</div>
        </div>

        {worlds.map((w, k) => (
          <article class="world" data-slug={w.id} data-layers={worldLayers(w).map((n) => n.toLowerCase()).join(' ')} data-cats={w.data.cats.join(' ')}>
            <figure class="world__plate" style={`margin:0;view-transition-name:plate-${w.id}`}>
              <div class="world__ink">
                <img src={`${CDN}/${w.data.plate}`} alt={w.data.alt} loading="lazy" decoding="async" width="1200" height="1500" />
                <video muted playsinline loop preload="none" aria-hidden="true"></video>
              </div>
            </figure>
            <div class="world__body">
              <span class="world__n">{ROMAN[k]}</span>
              <h3 class="world__name"><a class="world__link" href={`/worlds/${w.id}/`}>{w.data.name} <em>{w.data.em}</em></a></h3>
              <p class="world__desc">{w.data.line}</p>
              <span class="world__sector">{CATEGORY[w.data.cat].label}</span>
              <span class="world__meter"><Meter world={w} label={false} /></span>
            </div>
          </article>
        ))}
      </div>
      <div class="worlds__bar" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <!-- II. Engage: the offer, straight after the proof -->
  <section class="engage" id="engage" aria-labelledby="engage-title">
    <div class="wrap">
      <div class="engage__head">
        <h2 class="display" id="engage-title" data-split>Three <br><em>ways in</em></h2>
        <p data-reveal><b class="engage__pos">Agency-grade brand worlds, without the $50,000 minimum.</b> Start with what you have. Build what is missing. Keep it alive after launch. <a class="link" href="/rules/what-a-brand-world-costs-in-ontario/">What a brand world costs in Ontario</a><span class="engage__intake" data-intake hidden></span></p>
      </div>
      <ol class="ladder" data-ladder>
        <li class="rung rung--lead">
          <span class="rung__flag">Start here</span>
          <div class="rung__top"><span class="rung__n">I</span><svg class="rung__sigil" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M7.5 21h9M4 6.5h16"/><path d="M6.5 6.5L3.5 13h6zM17.5 6.5l-3 6.5h6z"/><path d="M3.5 13a3 2 0 0 0 6 0M14.5 13a3 2 0 0 0 6 0"/></svg></div>
          <h3 class="rung__name">The <em>Verdict</em></h3>
          <p class="rung__line">Where you stand, scored.</p>
          <p class="rung__big"><span class="rung__cur">$</span><b data-count="3500">3,500</b><span class="rung__unit">CAD and up</span></p>
          <ul class="rung__facts">
            <li>Every layer scored against your buyer and your regulator</li>
            <li>A ranked fix list, with an AI readiness check</li>
            <li>5 business days from your kickoff call</li>
            <li>Fee credited in full to your Build within 60 days</li>
          </ul>
          <div class="rung__cta"><a class="btn" href="/book/" data-magnetic>Book the free call</a><a class="link" href="#score">Score your world first</a></div>
        </li>
        <li class="ladder__link" aria-hidden="true"><svg viewBox="0 0 80 24"><path pathLength="1" d="M2 12H74M66 5l8 7-8 7"/></svg></li>
        <li class="rung">
          <span class="rung__tag">Your Verdict fee counts here</span>
          <div class="rung__top"><span class="rung__n">II</span><svg class="rung__sigil" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 21V9.5h2.5V6.5h2.5v3h1.5v-3h2v3h1.5v-3h2.5v3h2.5V21z"/><path d="M10 21v-4.5a2 2 0 0 1 4 0V21"/></svg></div>
          <h3 class="rung__name">The <em>Build</em></h3>
          <p class="rung__line">The world, built.</p>
          <p class="rung__big"><span class="rung__cur">$</span><b>25,000</b><span class="rung__unit">CAD for a full world</span></p>
          <ul class="rung__facts">
            <li>A complete world, or only the layers you are missing</li>
            <li>Single layers from $7,500</li>
            <li>Lore always comes first</li>
            <li>Delivered ready to launch, not ready for another round</li>
          </ul>
          <div class="rung__cta"><a class="link" href="/book/">Talk about a Build</a></div>
        </li>
        <li class="ladder__link" aria-hidden="true"><svg viewBox="0 0 80 24"><path pathLength="1" d="M2 12H74M66 5l8 7-8 7"/></svg></li>
        <li class="rung rung--keep">
          <span class="rung__tag">After launch</span>
          <div class="rung__top"><span class="rung__n">III</span><svg class="rung__sigil" viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="12" r="4.2"/><circle cx="7" cy="12" r="1.4"/><path d="M11.2 12H21M17.5 12v3.2M20.5 12v2.4"/></svg></div>
          <h3 class="rung__name">The <em>Keep</em></h3>
          <p class="rung__line">The world, kept.</p>
          <p class="rung__big"><span class="rung__cur">$</span><b>4,500</b><span class="rung__unit">CAD a month and up</span></p>
          <ul class="rung__facts">
            <li>Content, signage and campaigns</li>
            <li>AI agents, run and checked</li>
            <li>New locations and products, inside the rules</li>
            <li>Ad spend and printing billed separately</li>
          </ul>
          <div class="rung__cta"><a class="link" href="/book/">Ask about the Keep</a></div>
        </li>
      </ol>
    </div>
  </section>

  <!-- III. Layers -->
  <section class="layers" id="layers" aria-labelledby="layers-title">
    <div class="wrap">
      <div class="layers__aside">
        <p class="eyebrow">The method</p>
        <h2 class="display" id="layers-title" data-split>Seven layers, <br><em>built in order</em></h2>
        <p data-reveal>A world is more than a logo. Each layer holds up the next, and every one is written inside the rules of your category.</p>
        <div class="layers__dial" aria-hidden="true">
          <div class="layers__big"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span></div>
          <div class="layers__now"><b>Lore</b><span>Layer 1 of 7</span></div>
        </div>
      </div>

      <div style="position:relative">
        <div class="blade" aria-hidden="true"><i></i></div>
        <ol>
          {layers.map((l, k) => (
            <li class="layer" data-name={l.data.name}><span class="layer__n">{k + 1}</span><h3 class="layer__name">{l.data.name}</h3><p class="layer__what">{l.data.line}</p>{l.data.name === 'Law' && <p class="layer__cat" data-cat-law hidden></p>}<ul class="layer__tags">{l.data.tags.map((t) => <li>{t}</li>)}</ul><a class="link layer__more" href={`/layers/${l.id}/`}>The {l.data.name} layer</a>{drawers[l.data.name] && (
              <details class="layer__work"><summary><span>{drawers[l.data.name].label}</span><span class="layer__work-n">{drawers[l.data.name].imgs.length} pieces</span></summary><WorkGrid imgs={drawers[l.data.name].imgs} target={drawers[l.data.name].target} /></details>
            )}{l.data.name === 'Machinery' && <Fragment set:html={SQUIRE} />}</li>
          ))}
        </ol>
        <p class="rule-note" data-reveal>No layer is built before Lore.</p>
      </div>
    </div>
  </section>


  <!-- Score your world -->
  <section class="score" id="score" aria-labelledby="score-title">
    <div class="wrap">
      <div class="score__head">
        <p class="eyebrow">The Verdict, in two minutes</p>
        <h2 class="display" id="score-title" data-split>Score <br><em>your world</em></h2>
        <p data-reveal>Seven questions, one for each layer. Answer honestly. You get a score out of 70 and the layer most likely to bring you down.</p>
      </div>

      <div class="score__body">
        <div class="quiz" id="quiz">
          <div class="quiz__bar">
            <span class="quiz__step">Question <b data-q-now>1</b> of 7</span>
            <button type="button" class="quiz__back" data-q-back disabled>Back</button>
          </div>

          <fieldset class="q" data-layer="Lore" data-def="Who you are, who you stand against, and what you are called." data-fix="Without it, every other layer guesses. Write the brief and the codex first.">
            <legend><span class="q__layer">1 · Lore</span><span class="sr-only">Lore: Who you are, who you stand against, and what you are called.</span><span class="q__text">Can everyone on your team say who you serve, and who you stand against, in one sentence?</span></legend>
            <div class="q__opts"><button type="button" class="opt" data-v="10">Yes, the same sentence</button><button type="button" class="opt" data-v="5">Roughly</button><button type="button" class="opt" data-v="0">Not really</button></div>
          </fieldset>
          <fieldset class="q" data-layer="Law" data-def="What you can say, what you can charge, and how it is packaged." data-fix="One unchecked claim can cost a licence or a listing. Check every word against your regulator.">
            <legend><span class="q__layer">2 · Law</span><span class="sr-only">Law: What you can say, what you can charge, and how it is packaged.</span><span class="q__text">Has every claim on your site, ads and packaging been checked against <span data-cat-reg>your regulator's</span> rules?</span></legend>
            <div class="q__opts"><button type="button" class="opt" data-v="10">Yes, and it is documented</button><button type="button" class="opt" data-v="5">Some of it</button><button type="button" class="opt" data-v="0">Never checked</button></div>
          </fieldset>
          <fieldset class="q" data-layer="Language" data-def="Voice, hooks, content and ads, written to pass review." data-fix="Content that gets flagged or ignored costs twice. Set the voice, then write inside the rules.">
            <legend><span class="q__layer">3 · Language</span><span class="sr-only">Language: Voice, hooks, content and ads, written to pass review.</span><span class="q__text">Does your content sound like one brand, and does it pass platform review?</span></legend>
            <div class="q__opts"><button type="button" class="opt" data-v="10">Every time</button><button type="button" class="opt" data-v="5">Mostly</button><button type="button" class="opt" data-v="0">It gets flagged or ignored</button></div>
          </fieldset>
          <fieldset class="q" data-layer="Map" data-def="Site, search and AI visibility. Where people find your world." data-fix="If search and AI assistants cannot find you, nobody enters the world. Fix the site and the listings.">
            <legend><span class="q__layer">4 · Map</span><span class="sr-only">Map: Site, search and AI visibility. Where people find your world.</span><span class="q__text">When someone asks Google or an AI assistant for what you do nearby, do you come up?</span></legend>
            <div class="q__opts"><button type="button" class="opt" data-v="10">Near the top</button><button type="button" class="opt" data-v="5">Sometimes</button><button type="button" class="opt" data-v="0">Rarely or never</button></div>
          </fieldset>
          <fieldset class="q" data-layer="Ground" data-def="The physical space. Arrival, flow, signage and screens." data-fix="The space should feel like the site. Arrival, signage and screens are part of the brand.">
            <legend><span class="q__layer">5 · Ground</span><span class="sr-only">Ground: The physical space. Arrival, flow, signage and screens.</span><span class="q__text">Does your space, or the place you are sold, look and feel like your site and your ads?</span></legend>
            <div class="q__opts"><button type="button" class="opt" data-v="10">Seamlessly</button><button type="button" class="opt" data-v="5">In places</button><button type="button" class="opt" data-v="0">Not yet</button></div>
          </fieldset>
          <fieldset class="q" data-layer="Artifacts" data-def="Print, labels, packaging and forms. Everything a customer holds." data-fix="Everything a customer holds is a promise. Bring every label, form and menu into one system.">
            <legend><span class="q__layer">6 · Artifacts</span><span class="sr-only">Artifacts: Print, labels, packaging and forms. Everything a customer holds.</span><span class="q__text">Are your labels, forms, menus and packaging on brand and compliant?</span></legend>
