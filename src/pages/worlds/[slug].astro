---
// One codex page per world, from src/content/worlds/<slug>.json.
import Base from '../../layouts/Base.astro';
import Meter from '../../components/Meter.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { SIGILS } from '../../lib/sigils';
import { CDN, CATEGORY, LAYER_NAMES, ROMAN, getWorlds, getLayers, getForPages, worldLayers, type World } from '../../lib/site';

export async function getStaticPaths() {
  const worlds = await getWorlds();
  return worlds.map((w, i) => ({ params: { slug: w.id }, props: { i, worlds } }));
}
const { i, worlds } = Astro.props as { i: number; worlds: World[] };
const w = worlds[i], d = w.data;
const prev = worlds[(i - 1 + worlds.length) % worlds.length], next = worlds[(i + 1) % worlds.length];
const c = CATEGORY[d.cat];
const layers = await getLayers();
const fp = (await getForPages()).find((f) => f.data.cat === d.cat);
const full = `${d.name} ${d.em}`;
const built = worldLayers(w);
const count = built.length === 7 ? 'all seven built' : `${built.length} of 7 built`;
const host = d.url ? d.url.split('//')[1].replace(/\/$/, '') : null;
const ld = [{
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: full, description: d.line,
  creator: { '@type': 'Organization', name: 'KNGHT', url: 'https://knght.com/' },
  ...(d.url ? { about: { '@type': 'Organization', name: full, url: d.url } } : {}),
}];
const work = d.work.map(({ alt, src, width, height }) => ({ alt, src, width, height }));
---
<Base title={`${full}: a KNGHT world`} ogTitle={`${full}: a KNGHT world`} description={`${d.line} A brand world built by Sergio Ho, founder of KNGHT.`}
  path={`worlds/${w.id}/`} ogImage={`${CDN}/${d.plate}`} ld={ld} footer="home"
  nav={[{ href: '/#worlds', label: 'All worlds' }, { href: '/#layers', label: 'The layers' }, { href: '/#score', label: 'Score your world' }]}>
  <section class="whero">
    <div class="wrap whero__grid">
      <figure class="whero__plate" style={`view-transition-name: plate-${w.id}`}>
        <img src={`${CDN}/${d.plate}`} alt={d.alt} width="1200" height="1500" />
        {d.film && <video muted playsinline loop autoplay preload="auto" poster={`${CDN}/${d.plate}`} src={d.film} aria-hidden="true"></video>}
        <figcaption class="plate__note">Mood plate, not client work.{d.work.length > 0 && ' The work is below.'}</figcaption>
      </figure>
      <div class="whero__body">
        <p class="eyebrow">World {ROMAN[i]} · {c.label}</p>
        <h1 class="display whero__title">{d.name} <em>{d.em}</em></h1>
        <p class="whero__line">{d.line}</p>
        <dl class="whero__meta">
          <div><dt>Sector</dt><dd>{c.label}</dd></div>
          <div><dt>Rules</dt><dd>{c.rules.map((r) => r.title).join(', ')}</dd></div>
          {d.where && <div><dt>Where</dt><dd>{d.where}</dd></div>}
          {built.length > 0 && (
            <div class="whero__meter"><dt>Layers built</dt><dd><Meter world={w} /><span class="meter__names">{built.map((n, k) => <Fragment>{k > 0 && ' · '}<a href={`/layers/${n.toLowerCase()}/`}>{n}</a></Fragment>)}</span></dd></div>
          )}
          {d.url && <div><dt>Online</dt><dd><a class="link" href={d.url} rel="noopener">{host}</a></dd></div>}
        </dl>
      </div>
    </div>
  </section>

  <section class="wsec">
    <div class="wrap wsec__grid">
      <p class="eyebrow">The world</p>
      <div class="wsec__text" data-reveal>
        {d.about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {built.length > 0 && (
    <section class="wsec">
      <div class="wrap wsec__grid">
        <div class="wsec__aside">
          <p class="eyebrow">What we built</p>
          <h2 class="display wsec__h" data-split>Seven layers, <br><em>{count}</em></h2>
        </div>
        <ol class="chapters">
          {layers.map((l, n) => d.built[l.data.name]
            ? <li class="chapter chapter--work" data-reveal><span class="chapter__n">{n + 1}</span><h3 class="chapter__layer"><svg class="chapter__sig" viewBox="0 0 24 24" aria-hidden="true" set:html={SIGILS[l.id] || ''} /><a href={`/layers/${l.id}/`}>{l.data.name}</a></h3><p class="chapter__work">{d.built[l.data.name]}</p></li>
            : <li class="chapter chapter--work chapter--off" data-reveal><span class="chapter__n">{n + 1}</span><h3 class="chapter__layer"><svg class="chapter__sig" viewBox="0 0 24 24" aria-hidden="true" set:html={SIGILS[l.id] || ''} /><a href={`/layers/${l.id}/`}>{l.data.name}</a></h3><p class="chapter__work">Not built.</p></li>)}
        </ol>
      </div>
    </section>
  )}

  {d.impact && (
    <section class="wsec">
      <div class="wrap wsec__grid">
        <p class="eyebrow">What changed</p>
        <div class="wsec__text" data-reveal><p>{d.impact}</p></div>
      </div>
    </section>
  )}

  {work.length > 0 && (
    <section class="wsec wwork">
      <div class="wrap">
        <p class="eyebrow">From the work</p>
        <WorkGrid imgs={work} captions={false} />
      </div>
    </section>
  )}

  <section class="wsec">
    <div class="wrap wsec__grid">
      <p class="eyebrow">The rules of this world</p>
      <ul class="wrules" data-reveal>
        {c.rules.map((r) => <li><b>{r.title}</b><span>{r.text}</span></li>)}
      </ul>
      {fp && <p class="wrules__more"><a class="link" href={`/for/${fp.id}/`}>Brand worlds for {fp.data.noun}</a></p>}
    </div>
  </section>

  <nav class="wnext" aria-label="More worlds">
    <a class="wnext__link" href={`/worlds/${next.id}/`}>
      <span class="wrap wnext__inner">
        <span class="eyebrow">Next world · {ROMAN[(i + 1) % worlds.length]}</span>
        <span class="wnext__name">{next.data.name} <em>{next.data.em}</em></span>
        <span class="wnext__line">{next.data.line}</span>
      </span>
      <img class="wnext__plate" src={`${CDN}/${next.data.plate}`} alt="" loading="lazy" width="1200" height="1500" />
    </a>
    <div class="wrap wnext__foot">
      <a class="link" href={`/worlds/${prev.id}/`}>Previous: {prev.data.name} {prev.data.em}</a>
      <a class="link" href="/#worlds">All worlds</a>
    </div>
  </nav>

  <section class="wcta">
    <div class="wrap">
      <h2 class="display" data-split>Every world starts <br>with a <em class="sheen">Verdict.</em></h2>
      <p>Tell us what you&rsquo;re building and we&rsquo;ll show you what to fix first.</p>
      <div class="actions">
        <a class="btn" href="/book/" data-magnetic>Book the free call
          <svg class="arrow" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>
        <a class="link" href="/#score">Score your world first</a>
      </div>
    </div>
  </section>
</Base>
