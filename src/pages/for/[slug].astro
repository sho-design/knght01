---
// Category landing pages, from src/content/for/<slug>.json.
import Base from '../../layouts/Base.astro';
import { CDN, CATEGORY, getForPages, getLayers, getWorlds } from '../../lib/site';

export async function getStaticPaths() {
  const pages = await getForPages();
  return pages.map((f) => ({ params: { slug: f.id }, props: { f, pages } }));
}
const { f, pages } = Astro.props;
const d = f.data, c = CATEGORY[d.cat];
const layers = await getLayers();
const worlds = await getWorlds();
const cards = d.worlds.map((s: string) => worlds.find((w) => w.id === s)!).filter(Boolean);
const others = pages.filter((o: any) => o.id !== f.id);
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: `Brand worlds for ${d.noun}`, serviceType: 'Brand strategy, design and marketing',
    description: d.meta, areaServed: 'Ontario, Canada', provider: { '@type': 'ProfessionalService', name: 'KNGHT', url: 'https://knght.com/' },
    offers: { '@type': 'Offer', name: 'The Verdict', priceSpecification: { '@type': 'PriceSpecification', minPrice: 3500, priceCurrency: 'CAD' } } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'KNGHT', item: 'https://knght.com/' },
    { '@type': 'ListItem', position: 2, name: `For ${d.noun}`, item: `https://knght.com/for/${f.id}/` }] },
];
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<Base title={`${d.title} | KNGHT`} ogTitle={d.title} description={d.meta} path={`for/${f.id}/`} ogType="website" bodyClass="worldpage forpage" ld={ld}
  nav={[{ href: '/#worlds', label: 'Worlds' }, { href: '/#layers', label: 'The layers' }, { href: `/?for=${d.cat}#score`, label: 'Score your world' }]}>
  <section class="whero">
    <div class="wrap">
      <p class="eyebrow">For {d.noun} · {c.label}</p>
      <h1 class="display book__title" style="margin-top:24px">Brand worlds for <br><em>{d.noun}.</em></h1>
      <p class="for__answer">{d.answer}</p>
      <div class="actions">
        <a class="btn" href="/book/" data-magnetic>Book a Verdict
          <svg class="arrow" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>
        <a class="link" href={`/?for=${d.cat}#score`}>Score your world first</a>
      </div>
      <p class="hero__micro">Free 30-minute call · No obligation</p>
    </div>
  </section>

  <section class="wsec">
    <div class="wrap wsec__grid">
      <p class="eyebrow">The rules you work inside</p>
      <ul class="wrules" data-reveal>
        {c.rules.map((r) => <li><b>{r.title}</b><span>{r.text}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="wsec">
    <div class="wrap wsec__grid">
      <div class="wsec__aside">
        <p class="eyebrow">The codex</p>
        <h2 class="display wsec__h" data-split>Seven layers, <br><em>read for {c.short}</em></h2>
      </div>
      <ol class="chapters">
        {layers.map((l, n) => <li class="chapter" data-reveal><span class="chapter__n">{n + 1}</span><h3>{l.data.name}</h3><p>{l.data.line}</p>{(c as any)[l.data.name] && <p class="chapter__cat">{(c as any)[l.data.name]}</p>}</li>)}
      </ol>
    </div>
  </section>

  <section class="wsec">
    <div class="wrap">
      <p class="eyebrow" style="margin-bottom:clamp(28px,4vw,56px)">Worlds built for {d.noun}</p>
      <div class="fcards">
        {cards.map((x) => (
          <a class="wnav__card fcard" href={`/worlds/${x.id}/`}>
            <img src={`${CDN}/${x.data.plate}`} alt="" loading="lazy" width="1200" height="1500" />
            <span class="wnav__label">{CATEGORY[x.data.cat].label}</span>
            <span class="wnav__name">{x.data.name} <em>{x.data.em}</em></span>
            <span class="fcard__line">{x.data.line}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wcta">
    <div class="wrap">
      <h2 class="display" data-split>Every world starts <br>with a <em class="sheen">Verdict.</em></h2>
      <p>Fixed fee from $3,500 CAD. Scored report in 5 business days. Fee credited to your Build within 60 days.</p>
      <div class="actions">
        <a class="btn" href="/book/" data-magnetic>Book a Verdict
          <svg class="arrow" viewBox="0 0 18 10" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>
      </div>
      <p class="for__others">Also for: {others.map((o: any, k: number) => <Fragment>{k > 0 && ' · '}<a class="link" href={`/for/${o.id}/`}>{cap(o.data.noun)}</a></Fragment>)}</p>
    </div>
  </section>
</Base>
